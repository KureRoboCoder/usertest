{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build for debugging",
            "type": "shell",
            "command": "${workspaceFolder}/sh/build.sh",
            "args": [
                "${fileBasenameNoExtension}",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}